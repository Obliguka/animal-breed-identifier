# Animal Breed Identifier — переменные окружения
#
# 1. Скопируй этот файл в .env:
#    cp .env.example .env
#
# 2. Заполни обязательные поля

# Langfuse (получить после регистрации на http://localhost:3000)
# 1. Запусти docker compose up -d
# 2. Открой http://localhost:3000
# 3. Зарегистрируйся, создай проект
# 4. Настройки → API Keys → скопируй ключи
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# LiteLLM
LITELLM_MASTER_KEY=sk-litellm-master-key-123
LITELLM_PROXY_URL=http://localhost:4000
